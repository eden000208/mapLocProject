FROM python:3.11.12-slim
WORKDIR /app
COPY backend/requirements.txt backend/requirements-cloudflare.txt ./
RUN pip install --no-cache-dir -r requirements.txt -r requirements-cloudflare.txt
COPY backend/ ./
RUN useradd --create-home bsq && mkdir -p /app/data && chown -R bsq:bsq /app
USER bsq
EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1", "--no-access-log"]
